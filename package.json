{
  "name": "app-movil",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "docker:dev": "docker compose up",
    "docker:down": "docker compose down",
    "docker:build": "docker compose run --rm --no-deps dev npx ng build",
    "android:sync": "npm run docker:build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run docker:build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:live:emu": "npm run docker:build && CAP_SERVER_URL=http://10.0.2.2:${DEV_PORT:-4200} npx cap sync android && npx cap open android",
    "android:live:device": "npm run docker:build && npm run android:reverse && CAP_SERVER_URL=http://localhost:${DEV_PORT:-4200} npx cap sync android && npx cap open android",
    "android:reverse": "./scripts/live-device.sh"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/device": "^7.0.5",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/network": "^7.0.4",
    "@capacitor/preferences": "^7.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular/cli": "^17.3.8",
    "@angular/compiler-cli": "^17.3.0",
    "@capacitor/cli": "^7.6.9",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.2"
  }
}
